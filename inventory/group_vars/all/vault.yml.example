---
# All secrets resolved at runtime from HashiCorp Vault.
# Set VAULT_ADDR and VAULT_TOKEN (or use approle) before running.
#
# Copy this file to vault.yml and it will work as-is once vault_kv_infra_mount
# and vault_kv_env are set (they come from ../../../inventory-common) and
# proxmox_vm_manage_pve_node is set in env.yml.
# vault.yml is gitignored — never commit it.

# Password auth — reuses the same infra/<env>/proxmox/root secret the
# foreman deployment's ProxMox storage-expansion phase uses.
vault_proxmox_api_password: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/proxmox/root', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret[proxmox_vm_manage_pve_node + '_password'] }}"

# API token auth (recommended, scoped/revocable) — used by all three
# sub-roles (disk/NIC/snapshot) when set. Optional: only uncomment once a
# token exists. Mint one in PVE (Datacenter -> Permissions -> API Tokens)
# with at least VM.Config.Disk, VM.Config.Network, and VM.Snapshot on the
# relevant path, then store it at infra/<env>/proxmox/api_token.
# vault_proxmox_api_token_id:     "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/proxmox/api_token', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.token_id }}"
# vault_proxmox_api_token_secret: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/proxmox/api_token', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.token_secret }}"

# Bridge into the vars mgcdrd.infrabase's proxmox_* roles actually read.
# The collection no longer defaults these from vault_proxmox_api_* itself
# (infrabase >= 0.15.0) — every deployment sets them once, here.
proxmox_api_password: "{{ vault_proxmox_api_password }}"
# proxmox_api_token_id:     "{{ vault_proxmox_api_token_id }}"
# proxmox_api_token_secret: "{{ vault_proxmox_api_token_secret }}"
