---
# Deployment-specific variables — copy to env.yml and set values for your
# environment. env.yml is gitignored — never commit it.
#
# domain, vault_addr, ansible_user, and the vault_kv_* vars come from
# ../../../inventory-common (a second inventory source in ansible.cfg) and
# do NOT need to be set here.

# Which PVE node's API this deployment talks to for every run. Any node can
# manage the whole cluster via its API (state is synced cluster-wide via
# corosync/pmxcfs) — one fixed node works regardless of which node actually
# hosts the VM being changed. Password auth in vault.yml is looked up per
# this node since root@pam is node-local, not cluster-wide.
proxmox_vm_manage_pve_node: pve2

# Non-secret connection vars mgcdrd.infrabase's proxmox_* roles read
# directly — the collection has no defaults for these (infrabase >= 0.15.0),
# so every deployment sets them once. proxmox_api_host is set in site.yml
# from proxmox_vm_manage_pve_node above, not here.
proxmox_api_user: root@pam
proxmox_validate_certs: false
