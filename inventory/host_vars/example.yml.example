---
# Copy to inventory/host_vars/<hostname>.yml (matching the hostname as
# defined in ../../../../inventory-common/hosts.yml) to apply changes to
# that VM. All three lists are optional — only define the ones you need.
#
# These vars are the role's own interface (mgcdrd.infrabase.proxmox_vm_manage) —
# see that role's README for the complete per-entry key reference.

proxmox_vm_manage_disks:
  - slot: virtio1
    storage: truenas
    size: "400"
    state: present

proxmox_vm_manage_nics:
  - interface: net1
    bridge: vmbr1
    tag: 100

proxmox_vm_manage_snapshots:
  - snapname: "pre-change-{{ ansible_date_time.date }}"
    description: "Before disk/NIC changes"
    retention: 5
